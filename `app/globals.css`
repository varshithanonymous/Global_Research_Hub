body {
  margin: 0;
  background-color: #121212;
  color: #ffffff;
  font-family: 'Roboto', sans-serif;
  scroll-behavior: smooth;
}

a {
  text-decoration: none;
  color: inherit;
}

.navbar {
  position: fixed;
  top: 0;
  width: 100%;
  background-color: #121212;
  z-index: 1000;
  display: flex;
  justify-content: space-between;
  padding: 1rem 2rem;
  border-bottom: 1px solid #2A7AE4;
}

.navbar a {
  color: #F4A261;
  margin: 0 1rem;
  font-size: 1rem;
  font-weight: bold;
  transition: color 0.3s ease-in-out, transform 0.2s ease;
}

.navbar a:hover {
  color: #2A7AE4;
  transform: scale(1.1);
}

.section {
  padding: 5rem 2rem;
  text-align: center;
  position: relative;
}

.hero {
  height: 100vh;
  background: linear-gradient(135deg, #2A7AE4, #F4A261);
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  animation: glow 5s infinite;
}

.cta {
  background-color: #F4A261;
  padding: 1rem 2rem;
  border-radius: 5px;
  color: #fff;
  font-weight: bold;
  box-shadow: 0 0 10px #F4A261;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.cta:hover {
  transform: scale(1.1);
  box-shadow: 0 0 20px #2A7AE4;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 0.5rem;
  margin-bottom: 1rem;
  border: 1px solid #2A7AE4;
  border-radius: 5px;
  background: #121212;
  color: #fff;
}

.contact-form button {
  padding: 0.7rem 1.5rem;
  background-color: #2A7AE4;
  color: #fff;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  transition: transform 0.3s ease, background-color 0.3s ease;
}

.contact-form button:hover {
  transform: scale(1.1);
  background-color: #F4A261;
}

@keyframes glow {
  0% {
    box-shadow: 0 0 10px #2A7AE4;
  }
  100% {
    box-shadow: 0 0 20px #F4A261;
  }
}